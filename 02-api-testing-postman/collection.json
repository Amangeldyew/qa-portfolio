							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"API отклоняет запрос: 400 или 500\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([400, 500]);\r\n});\r\n// Наблюдение: правильный ответ на неполные данные это 400.\r\n// Если пришёл 500, API падает вместо валидации. Записать как дефект."
								]
