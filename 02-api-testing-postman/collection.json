		{
			"name": "02 Негативные сценарии",
			"item": [
				{
					"name": "Неверный пароль",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Статус-код 200 (особенность API: ошибка приходит с кодом 200)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"В ответе причина отказа Bad credentials\", function () {\r\n    pm.expect(pm.response.json().reason).to.equal(\"Bad credentials\");\r\n});\r\n\r\npm.test(\"Токен не выдан\", function () {\r\n    pm.expect(pm.response.json()).to.not.have.property(\"token\");\r\n});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"wrong_password\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth"
							]
						}
					},
					"response": []
